[Unit]
Description=Transfer CyberHunter AI output to bridge outbox
After=local-fs.target
ConditionPathIsDirectory=/var/lib/cyberhunter/ai/output
ConditionPathIsDirectory=/var/lib/cyberhunter/bridge/outbox

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/cyberhunter-ai-output-transfer
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ReadWritePaths=/var/lib/cyberhunter/ai/output
ReadWritePaths=/var/lib/cyberhunter/bridge/outbox
ReadWritePaths=/run/lock

